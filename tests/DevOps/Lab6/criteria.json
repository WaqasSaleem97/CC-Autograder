        },
        {
          "label": "Blob count column",
          "pattern": "Blob\\s+Count"
        },
        {
          "label": "Used size column",
          "pattern": "Used\\s+Size"
        },
        {
          "label": "Available space column",
          "pattern": "Available\\s+Space"
        },
        {
          "label": "Numeric storage values",
          "pattern": "\\d+(?:[.,]\\d+)?\\s*(?:Bytes|[KMGT]i?B)\\b"
        }
      ]
    }
  ]
}

